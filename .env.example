# TechLake — Environment Configuration
# Copy this file to .env on the server and fill in real values.
# .env is gitignored — NEVER commit it.

# ─── Admin ───────────────────────────────────────────────────
# Generate hash: php -r "echo password_hash('YOUR_PASSWORD', PASSWORD_BCRYPT, ['cost' => 12]);"
ADMIN_PASSWORD_HASH=

# ─── GitHub Webhook Deploy ────────────────────────────────────
# Must match the secret set in GitHub repo Settings > Webhooks
GITHUB_WEBHOOK_SECRET=

# Absolute path to the public_html directory on the server
DEPLOY_PATH=/home/YOUR_CPANEL_USERNAME/public_html

# Application environment
APP_ENV=production

# ─── Web3Forms keys ──────────────────────────────────────────
# Get your keys at https://web3forms.com (free plan, one key per email address)
# Restrict each key to techlake.co in the Web3Forms dashboard for extra security.

# Routes to info@techlake.co (main site contact form)
TECHLAKE_FORM_KEY=

# Routes to cribfin@gmail.com (Cribfin enquiry form)
CRIBFIN_FORM_KEY=

# ─── Contact details (served via js/config.php) ───────────────
# Never put these in HTML or JS files — they live here only.

# Main site email address
CONTACT_EMAIL=info@techlake.co

# Cribfin email address
CRIBFIN_EMAIL=

# WhatsApp number for Cribfin — digits only, no + or spaces.
# Include country code. Example for UK: 447700900000
# Example for Nigeria: 2348100000000
CRIBFIN_WHATSAPP=
